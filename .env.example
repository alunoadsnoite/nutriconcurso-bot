# Copie para .env e preencha. NUNCA commite o .env.

# Obrigatória para o /api/v1/chat responder. Sem ela o servidor sobe,
# mas /health reporta configured=false e o chat devolve 503.
OPENAI_API_KEY=sk-...

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=1200

# Opcional. Vazio = sem autenticação (útil em desenvolvimento).
# Ver a nota de segurança do README antes de expor a API.
API_KEY=

MAX_MESSAGE_LENGTH=4000
MAX_HISTORY_MESSAGES=12
HISTORY_TTL_SECONDS=3600

# Limite por endereço de origem.
REQUESTS_PER_MINUTE=20

# Limite por pessoa, independente do endereço.
# Sem isto, um único aluno na rede da escola (ou a mesma pessoa trocando de
# rede) consegue estourar a cota da API inteira. O identificador é o `user_id`
# que o app envia; requisição sem `user_id` só obedece ao limite por IP.
REQUESTS_PER_MINUTE_PER_USER=40

# Só ligue se a API estiver ATRÁS de um proxy reverso (NGINX, Cloudflare,
# Fly, Render). O cabeçalho X-Forwarded-For é controlado por quem faz a
# requisição: ligado sem proxy, qualquer aluno manda um IP falso por requisição
# e escapa do limite inteiro. Com proxy ligado, confira também se ele
# SOBRESCREVE (e não anexa) o X-Forwarded-For recebido do cliente.
TRUST_PROXY=false

# --- RAG (busca vetorial no Supabase/pgvector) -----------------------------
# Sem estas duas, o servidor sobe normalmente e o chat responde SEM contexto:
# /health reporta rag_configured=false. Com elas, o /api/v1/chat passa a buscar
# trechos oficiais e devolver `sources`.

SUPABASE_URL=https://seuprojeto.supabase.co
# A chave `anon` basta para o chat, porque o SELECT acontece dentro da função
# `match_documents` (security definer). Para INGESTAR documentos é preciso
# INSERT, e aí use a `service_role`. Nunca nenhuma das duas no app mobile.
SUPABASE_KEY=

EMBEDDING_MODEL=text-embedding-3-small
# Tem que bater com a coluna VECTOR(n) criada em migrations/001_rag.sql.
# O padrão do text-embedding-3-small é 1536. Para usar menos, mude os dois.
EMBEDDING_DIMENSIONS=1536

RAG_MATCH_THRESHOLD=0.25
RAG_MATCH_COUNT=5
RAG_MAX_CHUNK_CHARS=1200
RAG_MAX_CONTEXT_CHARS=8000

# Busca híbrida: vetorial + full-text em português, fundidas por RRF.
#
# DESLIGADA por padrão porque depende de migrations/002_busca_hibrida.sql, que
# cria a coluna `content_tsv` e a função `match_documents_hybrid`. Só ligue
# depois de rodar a migration E o teste de fumaça, porque não há como validar
# isso contra um Postgres real a partir do CI.
#
# Quando ligar, vale saber o que muda: o trecho passa a entrar também por
# correspondência de palavra exata, o que acerta o caso em que a pergunta usa
# vocabulário diferente do documento ("merenda" contra "alimentos"). Em troca,
# trecho encontrado só por texto chega sem similaridade de cosseno, e o app
# mostra a fonte sem o percentual.
RAG_HYBRID=false
# Fator do RRF. Menor valor dá mais peso ao primeiro colocado de cada busca.
RAG_RRF_K=60


# --- Perguntas sugeridas ----------------------------------------------------
# Cada resposta custa uma chamada curta ao modelo. Ponha 0 para desligar, se a
# cota de uso apertar. O app esconde os chips quando a lista vem vazia, e a
# falha na geração nunca derruba a resposta.

SUGGESTIONS_COUNT=3
SUGGESTIONS_MAX_TOKENS=150
